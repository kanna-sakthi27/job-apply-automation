# Copy to .env and fill in. chmod 600 .env. NEVER commit it.

# --- Telegram run reports -------------------------------------------------
# Create a bot with @BotFather, then message it once so the chat exists.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Browser --------------------------------------------------------------
# Brave is launched with --remote-debugging-port and attached over CDP.
BRAVE_CDP_PORT=9222

# --- Models ---------------------------------------------------------------
# Preference order, comma separated. Free ids (`:free` / `-free`) cost nothing
# from the Command Code plan; a paid id is only tried while the quota gate allows.
APPLY_MODELS=poolside/laguna-s-2.1-free,meituan/longcat-2.0:free,deepseek/deepseek-v4-flash

# --- Run budgets ----------------------------------------------------------
APPLY_TIMEOUT_SECONDS=2700      # whole-run budget
APPLY_PER_MODEL_SECONDS=1200    # per-model attempt cap
APPLY_MAX_TURNS=250             # headless turn budget
